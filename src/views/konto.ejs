<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArBank - Konto</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap');

/* Importing the high-end font */
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap');

:root {
  --bg-dark: #020617;
  --accent: #3b82f6;
  --glass: rgba(255, 255, 255, 0.03);
  --glass-border: rgba(255, 255, 255, 0.08);
  --text-dim: #94a3b8;
  --card-gradient: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
}

/* 1. THE GAP-KILLER RESET */
html, body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100%;
  min-height: 100vh;
  background-color: var(--bg-dark);
  background-image: 
    radial-gradient(at 0% 0%, hsla(225,39%,20%,1) 0, transparent 50%), 
    radial-gradient(at 100% 100%, hsla(260,49%,20%,1) 0, transparent 50%);
  color: #f8fafc;
  display: flex;
  flex-direction: column;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* 2. DOCK-TO-TOP HEADER */
header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 80px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8%;
  background: rgba(2, 6, 23, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  z-index: 1000;
}

#logo {
  font-size: 1.6rem;
  font-weight: 800;
  color: #fff;
  text-decoration: none;
  letter-spacing: -1px;
}

nav a {
  margin-left: 30px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--text-dim);
  transition: 0.3s;
}

nav a:hover { color: #fff; }

/* 3. MAIN CONTENT */
main {
  flex-grow: 1;
  padding: 120px 20px 60px; /* Offset for fixed header */
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 4. PREMIUM ACCOUNT CARD */
.account-card {
  background: var(--card-gradient);
  position: relative;
  overflow: hidden;
  color: #fff;
  border-radius: 28px;
  padding: 40px;
  width: 100%;
  max-width: 480px;
  border: 1px solid var(--glass-border);
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  gap: 20px;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.account-card::after {
  content: "";
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.1), transparent 70%);
  pointer-events: none;
}

.account-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: var(--accent);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--text-dim);
}

.card-balance {
  font-size: 2.5rem;
  font-weight: 800;
  margin: 10px 0;
  letter-spacing: -1px;
}

.card-number {
  font-family: 'Courier New', monospace;
  letter-spacing: 4px;
  font-size: 1.2rem;
  color: #fff;
  opacity: 0.8;
}

/* 5. BUTTON STYLING */
.btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.95rem;
  text-decoration: none;
  text-align: center;
  border: none;
  cursor: pointer;
  transition: 0.3s all ease;
}

/* Primary Transfer Button */
.account-card .btn {
  background: #fff;
  color: #020617;
  margin-top: 10px;
}

.account-card .btn:hover {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
}

/* Bottom Action Buttons */
.btn.create-card, .btn.secondary {
  background: var(--glass);
  color: #fff;
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(10px);
}

.btn.create-card:hover, .btn.secondary:hover {
  background: rgba(255,255,255,0.1);
  border-color: #fff;
  transform: translateY(-3px);
}

.account-content {
  width: 100%;
  max-width: 980px;
  display: grid;
  grid-template-columns: 480px 1fr;
  gap: 24px;
  align-items: start;
}

.right-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.transactions-panel,
.danger-panel {
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
}

.panel-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.panel-title h2,
.danger-panel h2 {
  font-size: 1.25rem;
  letter-spacing: -0.5px;
}

.panel-title span {
  color: var(--text-dim);
  font-size: 0.85rem;
}

.transaction-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.empty-transactions {
  color: var(--text-dim);
  border: 1px dashed var(--glass-border);
  border-radius: 16px;
  padding: 18px;
  line-height: 1.6;
}

.transaction-item {
  width: 100%;
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  color: #fff;
  padding: 14px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px 16px;
  cursor: pointer;
  text-align: left;
  transition: 0.25s;
}

.transaction-item:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.22);
  transform: translateY(-2px);
}

.transaction-name {
  font-weight: 700;
}

.transaction-date,
.transaction-category {
  color: var(--text-dim);
  font-size: 0.82rem;
}

.transaction-amount {
  font-weight: 800;
  grid-row: span 2;
  align-self: center;
}

.transaction-amount.in,
.modal-amount.in {
  color: #22c55e;
}

.transaction-amount.out,
.modal-amount.out {
  color: #f87171;
}

.danger-panel {
  border-color: rgba(248, 113, 113, 0.35);
}

.danger-panel p {
  color: var(--text-dim);
  line-height: 1.6;
  margin: 10px 0 16px;
}

.delete-profile-btn {
  width: 100%;
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
  border: 1px solid rgba(248, 113, 113, 0.5);
}

.delete-profile-btn:hover {
  background: rgba(248, 113, 113, 0.22);
}

.modal {
  position: fixed;
  inset: 0;
  display: none;
  place-items: center;
  padding: 20px;
  background: rgba(2, 6, 23, 0.72);
  backdrop-filter: blur(8px);
  z-index: 2000;
}

.modal.open {
  display: grid;
}

.modal-box {
  width: 100%;
  max-width: 460px;
  background: #0f172a;
  border: 1px solid var(--glass-border);
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
}

.modal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.modal-top h3 {
  font-size: 1.25rem;
}

.modal-close {
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  border: 1px solid var(--glass-border);
  border-radius: 10px;
  padding: 8px 12px;
  cursor: pointer;
}

.detail-line {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  border-top: 1px solid var(--glass-border);
  padding: 12px 0;
}

.detail-line span:first-child {
  color: var(--text-dim);
}

/* 6. FOOTER */
footer {
  text-align: center;
  padding: 40px;
  background: rgba(2, 6, 23, 0.5);
  border-top: 1px solid var(--glass-border);
  color: var(--text-dim);
  font-size: 0.85rem;
}

/* MOBILE FIX */
@media (max-width: 768px) {
  header { height: auto; padding: 20px; flex-direction: column; gap: 15px; }
  nav a { margin: 0 10px; }
  main { padding-top: 160px; }
  .account-card { padding: 30px; }
  div[style*="flex-direction: column"] { width: 100%; }
  div[style*="display: flex; gap: 15px"] { flex-direction: column; width: 100%; padding: 0 20px; }
  .account-content { grid-template-columns: 1fr; }
  .transaction-item { grid-template-columns: 1fr; }
  .transaction-amount { grid-row: auto; }
}
  </style>
</head>
<body>
  <%
    function formatTransactionAmount(amount) {
      if (typeof amount === "string") return amount
      const sign = amount > 0 ? "+" : "-"
      return `${sign}${Math.abs(amount).toLocaleString("no-NO")},00 NOK`
    }

    const transactionList = typeof transactions !== "undefined" ? transactions.map(transaction => ({
      date: transaction.date,
      text: transaction.text,
      category: transaction.category,
      amount: formatTransactionAmount(transaction.amount),
      type: transaction.type,
      from: transaction.sender || transaction.from,
      to: transaction.receiver || transaction.to,
      reference: transaction.reference
    })) : []
  %>

  <header>
    <a href="/" id="logo">ArBank</a>
    <nav>
      <a href="/">Hjem</a>
      <a href="/konto">Konto</a>
      <a href="/konto/tjenester">Tjenester</a>
      <a href="/support">Support</a>
      <a href="/info">Om Oss</a>
    </nav>
  </header>

  <main>

  <% if (typeof errorDeletion !== "undefined" && errorDeletion) { %>
  <div style="
    background: rgba(248, 113, 113, 0.12);
    border: 1px solid rgba(248, 113, 113, 0.5);
    color: #fecaca;
    padding: 14px 16px;
    border-radius: 12px;
    margin: 20px auto;
    max-width: 600px;
    text-align: center;
    font-weight: 600;
  ">
    <%= errorDeletion %>
  </div>
<% } %>

    <div class="account-content">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
        <div class="account-card">
          <div class="card-header">
            <h3>ArBank Debit</h3>
            <span>Kort</span>
          </div>
          
            <div class="card-number">
                <%= card_number %>
            </div>

          <div class="card-balance">
            <%= balance %> NOK
          </div>

          <a href="/overfore" class="btn">Overfør penger</a>
        </div>

        <div style="display: flex; gap: 15px;">
          <form action="/konto/nytt-kort" method="POST">
            <button type="submit" class="btn create-card">Opprett nytt kort</button>
          </form>

          <form action="/konto/bytt-kort" method="GET">
            <button type="submit" class="btn secondary">Bytt kort</button>
          </form>
        </div>
      </div>

      <div class="right-panel">
        <section class="transactions-panel">
          <div class="panel-title">
            <h2>Transaksjoner</h2>
            <span>Klikk for detaljer</span>
          </div>

          <div class="transaction-list">
            <% if (!transactionList.length) { %>
              <p class="empty-transactions">Ingen transaksjoner enda. Gå til Tjenester og trykk Handle for å lage en gevinst eller et tap.</p>
            <% } %>

            <% transactionList.forEach(transaction => { %>
              <button
                type="button"
                class="transaction-item"
                data-date="<%= transaction.date %>"
                data-text="<%= transaction.text %>"
                data-category="<%= transaction.category %>"
                data-amount="<%= transaction.amount %>"
                data-type="<%= transaction.type %>"
                data-from="<%= transaction.from || 'Ikke valgt' %>"
                data-to="<%= transaction.to || 'Ikke valgt' %>"
                data-reference="<%= transaction.reference || 'Ingen referanse' %>"
              >
                <span class="transaction-name"><%= transaction.text %></span>
                <span class="transaction-amount <%= transaction.type %>"><%= transaction.amount %></span>
                <span class="transaction-date"><%= transaction.date %></span>
                <span class="transaction-category"><%= transaction.category %></span>
              </button>
            <% }) %>
          </div>
        </section>

        <section class="danger-panel">
          <h2>Slett profil</h2>
          <p>Dette er frontend-delen. Når du lager backend kan denne formen kobles til logikken som sletter brukeren.</p>
          <form action="/users/slett-profil" method="POST">
            <button type="submit" class="btn delete-profile-btn">Slett profilen min</button>
          </form>
        </section>
      </div>
    </div>
  </main>

  <div class="modal" id="transactionModal">
    <div class="modal-box">
      <div class="modal-top">
        <h3 id="modalTitle">Transaksjon</h3>
        <button type="button" class="modal-close" id="closeModal">Lukk</button>
      </div>
      <div class="detail-line"><span>Dato</span><strong id="modalDate"></strong></div>
      <div class="detail-line"><span>Kategori</span><strong id="modalCategory"></strong></div>
      <div class="detail-line"><span>Belop</span><strong id="modalAmount" class="modal-amount"></strong></div>
      <div class="detail-line"><span>Fra</span><strong id="modalFrom"></strong></div>
      <div class="detail-line"><span>Til</span><strong id="modalTo"></strong></div>
      <div class="detail-line"><span>Referanse</span><strong id="modalReference"></strong></div>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ArBank. Alle rettigheter reservert.
  </footer>

  <script>
    const modal = document.getElementById("transactionModal")
    const closeModal = document.getElementById("closeModal")

    document.addEventListener("click", (event) => {
      const transactionElement = event.target.closest(".transaction-item")
      if (!transactionElement) return

      document.getElementById("modalTitle").textContent = transactionElement.dataset.text
      document.getElementById("modalDate").textContent = transactionElement.dataset.date
      document.getElementById("modalCategory").textContent = transactionElement.dataset.category
      document.getElementById("modalAmount").textContent = transactionElement.dataset.amount
      document.getElementById("modalAmount").className = `modal-amount ${transactionElement.dataset.type}`
      document.getElementById("modalFrom").textContent = transactionElement.dataset.from
      document.getElementById("modalTo").textContent = transactionElement.dataset.to
      document.getElementById("modalReference").textContent = transactionElement.dataset.reference
      modal.classList.add("open")
    })

    closeModal.addEventListener("click", () => {
      modal.classList.remove("open")
    })

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        modal.classList.remove("open")
      }
    })
  </script>
</body>
</html>





