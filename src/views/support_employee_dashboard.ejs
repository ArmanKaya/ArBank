<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArBank - Support Dashboard</title>
  <style>
    :root {
      --bg: #081021;
      --panel: #101b34;
      --line: #1b2b4f;
      --text: #e9eefb;
      --muted: #93a5c7;
      --ok: #14b866;
      --err: #ff5f6d;
      --btn: #2e6cff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: radial-gradient(circle at 20% 0%, #13274d 0%, #081021 55%);
      color: var(--text);
      min-height: 100vh;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      border-bottom: 1px solid var(--line);
      background: rgba(6, 11, 24, 0.86);
      position: sticky;
      top: 0;
    }
    #logo {
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 22px;
    }
    .meta {
      color: var(--muted);
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .meta strong { color: #fff; }
    .meta button {
      border: 0;
      background: #203666;
      color: #fff;
      border-radius: 8px;
      padding: 8px 10px;
      cursor: pointer;
      font-weight: 700;
    }
    .wrap {
      max-width: 1200px;
      margin: 20px auto;
      padding: 0 16px 20px;
      display: grid;
      gap: 14px;
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ring {
      width: 54px;
      height: 54px;
      border-radius: 999px;
      border: 6px solid #2a3d66;
      border-top-color: #66a3ff;
      flex-shrink: 0;
    }
    .card h3 { margin: 0; font-size: 15px; }
    .card p { margin: 2px 0 0; color: var(--muted); font-size: 13px; }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px;
    }
    h2 { margin: 0 0 10px; }
    .msg { padding: 10px; border-radius: 8px; margin-bottom: 12px; font-size: 14px; }
    .ok { background: rgba(20,184,102,.18); color: #9af3c6; border: 1px solid rgba(20,184,102,.4); }
    .err { background: rgba(255,95,109,.14); color: #ff9aa2; border: 1px solid rgba(255,95,109,.35); }
    input, select, textarea, button {
      border-radius: 8px;
      border: 1px solid var(--line);
      background: #0c1630;
      color: #fff;
      padding: 9px;
    }
    button {
      border: 0;
      background: var(--btn);
      font-weight: 700;
      cursor: pointer;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    th, td {
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--line);
      padding: 9px 8px;
    }
    th { font-size: 12px; color: var(--muted); text-transform: uppercase; }
    .link {
      color: #9fc2ff;
      text-decoration: none;
      font-weight: 700;
    }
    .employee-form {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .employee-form input { min-width: 220px; }
    .closed {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 10px;
      background: #0c1630;
    }
    .closed summary {
      cursor: pointer;
      font-weight: 700;
      color: #dbe8ff;
      list-style: none;
      outline: none;
    }
    .closed summary::-webkit-details-marker {
      display: none;
    }
    .closed summary::before {
      content: "▸";
      margin-right: 8px;
      color: #9fc2ff;
    }
    .closed[open] summary::before {
      content: "▾";
    }
    .closed .inner {
      margin-top: 10px;
    }
    @media (max-width: 980px) {
      .stats { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      header { flex-direction: column; align-items: flex-start; gap: 8px; }
      .stats { grid-template-columns: 1fr; }
      .employee-form { flex-direction: column; }
      .employee-form input, .employee-form button { width: 100%; }
    }
  </style>
</head>
<body>
  <header>
    <a href="/" id="logo">ArBank</a>
    <div class="meta">
      <span>Innlogget: <strong><%= employee.navn %></strong> (<%= employee.stilling %>)</span>
      <form action="/support/ansatt/logout" method="POST">
        <button type="submit">Logg ut</button>
      </form>
    </div>
  </header>

  <main class="wrap">
    <% if (ok) { %><div class="msg ok"><%= ok %></div><% } %>
    <% if (error) { %><div class="msg err"><%= error %></div><% } %>

    <section class="stats">
      <article class="card">
        <div class="ring"></div>
        <div>
          <h3>Total</h3>
          <p><%= stats.total %> tickets</p>
        </div>
      </article>
      <article class="card">
        <div class="ring"></div>
        <div>
          <h3>Ny</h3>
          <p><%= stats.ny %> (<%= stats.nyPct %>%)</p>
        </div>
      </article>
      <article class="card">
        <div class="ring"></div>
        <div>
          <h3>Under behandling</h3>
          <p><%= stats.under %> (<%= stats.underPct %>%)</p>
        </div>
      </article>
      <article class="card">
        <div class="ring"></div>
        <div>
          <h3>Løst</h3>
          <p><%= stats.lost %> (<%= stats.lostPct %>%)</p>
        </div>
      </article>
    </section>

    <% if (employee.stilling === "leder") { %>
      <section class="panel">
        <h2>Legg til ansatt</h2>
        <form class="employee-form" action="/support/ansatt/ny" method="POST">
          <input type="text" name="navn" placeholder="Eksisterende brukernavn" required>
          <input type="text" name="stilling" placeholder="Stilling (ansatt/leder)" required>
          <button type="submit">Legg til</button>
        </form>
      </section>
    <% } %>

    <section class="panel">
      <h2>Aktive tickets</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Bruker</th>
            <th>Tema</th>
            <th>Status</th>
            <th>Svar</th>
            <th>Åpne</th>
            <th>Lagre</th>
          </tr>
        </thead>
        <tbody>
          <% if (!activeTickets || activeTickets.length === 0) { %>
            <tr><td colspan="7">Ingen tickets enda.</td></tr>
          <% } %>
          <% if (activeTickets && activeTickets.length > 0) { %>
            <% activeTickets.forEach((ticket) => { %>
              <tr>
                <td>#<%= ticket.id %></td>
                <td><%= ticket.user_name || "-" %></td>
                <td><%= ticket.tema %></td>
                <td><%= ticket.status %></td>
                <td><%= ticket.svar || "-" %></td>
                <td><a class="link" href="/support/ansatt/ticket/<%= ticket.id %>">Tråd</a></td>
                <td>
                  <form action="/support/ansatt/ticket" method="POST">
                    <input type="hidden" name="ticket_id" value="<%= ticket.id %>">
                    <select name="status">
                      <option value="Ny" <%= ticket.status === "Ny" ? "selected" : "" %>>Ny</option>
                      <option value="Under behandling" <%= ticket.status === "Under behandling" ? "selected" : "" %>>Under behandling</option>
                      <option value="Løst" <%= ticket.status === "Løst" ? "selected" : "" %>>Løst</option>
                    </select>
                    <textarea name="svar" rows="2" placeholder="Kort svar"><%= ticket.svar || "" %></textarea>
                    <button type="submit">Lagre</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </section>

    <section class="panel">
      <details class="closed">
        <summary>Løste tickets (<%= closedTickets ? closedTickets.length : 0 %>)</summary>
        <div class="inner">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Bruker</th>
                <th>Tema</th>
                <th>Status</th>
                <th>Svar</th>
                <th>Åpne</th>
              </tr>
            </thead>
            <tbody>
              <% if (!closedTickets || closedTickets.length === 0) { %>
                <tr><td colspan="6">Ingen løste tickets enda.</td></tr>
              <% } %>
              <% if (closedTickets && closedTickets.length > 0) { %>
                <% closedTickets.forEach((ticket) => { %>
                  <tr>
                    <td>#<%= ticket.id %></td>
                    <td><%= ticket.user_name || "-" %></td>
                    <td><%= ticket.tema %></td>
                    <td><%= ticket.status %></td>
                    <td><%= ticket.svar || "-" %></td>
                    <td><a class="link" href="/support/ansatt/ticket/<%= ticket.id %>">Tråd</a></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </details>
    </section>
  </main>
</body>
</html>

